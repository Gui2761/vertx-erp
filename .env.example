# Modelo sem credenciais. Preencha no painel Render; nunca versione .env.
# Homologação/produção:
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
DATABASE_SSL_REQUIRE=True
CONN_MAX_AGE=60
UPLOAD_STORAGE=s3
S3_BUCKET_NAME=
# R2: copie o endpoint S3 da sua conta; não é a URL pública do bucket.
S3_ENDPOINT_URL=
# R2 usa auto; AWS S3 usa a região efetiva do bucket.
S3_REGION_NAME=
S3_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional, somente se o provedor emitir credencial temporária:
# AWS_SESSION_TOKEN=
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
TIME_ZONE=America/Maceio

# HSTS: habilite subdomínios somente após confirmar HTTPS em todos eles.
# Preload não cadastra o domínio automaticamente numa lista do navegador.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Render fornece automaticamente RENDER_EXTERNAL_HOSTNAME e PORT.
# O hostname Render é incluído em ALLOWED_HOSTS/CSRF_TRUSTED_ORIGINS.
# Preencha explicitamente hosts/origens adicionais quando usar domínio próprio.

# Desenvolvimento Docker local: altere DEBUG=True, UPLOAD_STORAGE=local,
# DATABASE_SSL_REQUIRE=False. DATABASE_URL pode ficar vazio somente com DEBUG=True.
# Estes nomes mantêm compatibilidade com o Compose; senha deve ser escolhida por você.
POSTGRES_DB=tecnolmed
POSTGRES_USER=tecnolmed
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Somente local/volumes persistentes, não usados para uploads S3:
# MEDIA_ROOT=/app/media
# PRIVATE_MEDIA_ROOT=/app/media_private
